# Tokyo Gogh Alt themed configuration.

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Tokyo Gogh Alt Palette #####

BG=0xff1a1b26
BG_ALT=0xff1d1f2d
BG_TAB=0xff222332

FG=0xffc0caf5
MUTED=0xff545964
DIM=0xff676f7d

BLUE=0xff6199ef         # #6199ef
BRIGHT_BLUE=0xff7aa2f7  # #7aa2f7
CYAN=0xff36c0c0         # #36c0c0
GREEN=0xff72c369        # #72c369
RED=0xffeb6572          # #eb6572
PINK=0xfff7768e         # #f7768e
ORANGE=0xffe08f68       # #e08f68
YELLOW=0xffe5c07b       # #e5c07b
PURPLE=0xffc678dd       # #c678dd
BLACK=0xff000000        # #000000

BORDER=0xff414868
SELECTION=0xff1f253f

##### Bar Appearance #####

### If aerospace is disabled:
# sketchybar --bar \
# position=top \
#  height=32 \
#  margin=0 \
#  y_offset=0 \
#  corner_radius=0 \
#  blur_radius=30 \
#  color=0xff16161e


### Aerospace bar:
 sketchybar --bar \
   position=top \
   height=40 \
   margin=20 \
   y_offset=5 \
   corner_radius=15 \
   blur_radius=30 \
   color=0xff16161e

### Add event listener for aerospace
sketchybar --add event aerospace_workspace_change

##### Changing Defaults #####

default=(
  padding_left=7
  padding_right=7

  icon.font="JetBrainsMono Nerd Font:SemiBold:12.0"
  label.font="JetBrainsMono Nerd Font:SemiBold:12.0"

  icon.color=$FG
  label.color=$FG

  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)

sketchybar --default "${default[@]}"

##### Adding Apple Icon

sketchybar --add item apple left \
           --set apple \
             icon="􀣺" \
             icon.font="JetBrainsMono Nerd Font:SemiBold:16.0" \
             icon.color=$RED \
             label.drawing=off \
             click_script="open -a 'System Settings'"

##### Adding Aerospace Space Indicators #####

for sid in $(aerospace list-workspaces --all); do
    sketchybar --add item space.$sid left \
        --subscribe space.$sid aerospace_workspace_change \
        --set space.$sid \
        icon="$sid" \
        icon.color=$MUTED \
        icon.padding_left=7 \
        icon.padding_right=7 \
        background.color=$BG_ALT \
        background.corner_radius=5 \
        background.height=25 \
        background.drawing=on \
        label.drawing=off \
        click_script="aerospace workspace $sid" \
        script="$PLUGIN_DIR/aerospace.sh $sid"
done

